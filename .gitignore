# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI tooling (kept on disk, not published)
.impeccable/
AGENTS.md
CLAUDE.md
.claude/

# video tooling: regenerable frames and its own dependencies
/brag-output/work/
/brag-output/source/node_modules/
/brag-output/music/

# NCS clips for the local intro preview only (not deployed)
/public/intro/audio/

# taste-skill working files
/.taste-skill/

# raw screenshots Kushal drops in for case studies (processed copies go to src/assets/case-studies)
/docs/case-study-assets/

# raw footage captures (capture.mjs regenerates them); the sized JPEGs in assets/v are kept
/brag-output/source/assets/*.png

# working notes with client-internal details (OMNIA); kept local
/docs/drafts/omnia-copy.md
